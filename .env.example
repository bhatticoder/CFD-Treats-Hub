# Required environment variables for CFD Hostel Treats
# Copy this file to .env.local and fill in the values.

# Firebase (client SDK — used for magic-link auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key

# Firebase Admin SDK (server-side — session creation, Firestore)
# Generate these from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=cfd-treats-hub
FIREBASE_CLIENT_EMAIL=your-service-account-email@appspot.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional but recommended for reliable session-cookie signing.
# If omitted, server falls back to FIREBASE_CLIENT_EMAIL.
FIREBASE_SERVICE_ACCOUNT_ID=your-service-account-email@appspot.gserviceaccount.com

# Supabase (only needed if using Supabase features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
