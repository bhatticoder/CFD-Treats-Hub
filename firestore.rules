rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Role + campus are read from the user's profile document.
    function profileData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && profileData().role == 'admin';
    }

    function isManager() {
      return signedIn() && profileData().role == 'manager';
    }

    function isManagerOrHigher() {
      return isManager() || isAdmin();
    }

    function myCampusId() {
      return signedIn() ? profileData().campus_id : null;
    }

    function sameCampus(cid) {
      return signedIn() && myCampusId() == cid;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveStaff() {
      return isManagerOrHigher() && profileData().is_active == true;
    }

    function staffForCampus(cid) {
      return isActiveStaff() && sameCampus(cid);
    }

    // Restrict client writes on orders to the status-escalation fields only.
    function allowedOrderUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['order_status', 'cancel_reason', 'delivered_at']);
    }

    // ── profiles: each user reads/writes their own; admins manage all ──────
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isManager();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    // ── campuses: staff manage; all signed-in users can read ───────────────
    match /campuses/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || staffForCampus(id);
    }

    // ── items: staff manage own campus; customers read for menu ────────────
    match /items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || staffForCampus(resource.data.campus_id);
    }

    // ── item_categories: staff manage; customers read ──────────────────────
    match /item_categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || staffForCampus(resource.data.campus_id);
    }

    // ── restaurants: staff manage; customers read ──────────────────────────
    match /restaurants/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || staffForCampus(resource.data.campus_id);
    }

    // ── vouchers: customers read (apply promos); admins/staff manage ───────
    match /vouchers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || staffForCampus(resource.data.campus_id);
    }

    // ── notifications: customers read own campus; staff manage ─────────────
    match /notifications/{id} {
      allow read: if signedIn() && sameCampus(resource.data.campus_id);
      allow create: if isAdmin() || isActiveStaff();
      allow update, delete: if isAdmin() || staffForCampus(resource.data.campus_id);
    }

    // ── push_subscriptions: users manage their own; staff/admin read ───────
    match /push_subscriptions/{uid} {
      allow read: if isActiveStaff() || isAdmin();
      allow write: if isOwner(uid);
    }

    // ── orders: owner or staff ─────────────────────────────────────────────
    match /orders/{id} {
      // Owner tracks their own order; staff/admin see all.
      allow read: if isOwner(resource.data.customer_id)
        || isAdmin()
        || staffForCampus(resource.data.campus_id);

      // Orders are placed server-side via Admin SDK. Direct client creates
      // are not allowed in rules; staff may only escalate status fields.
      allow create: if false;
      allow update: if (isAdmin() || staffForCampus(resource.data.campus_id))
        && allowedOrderUpdate();
      allow delete: if false;
    }

    // ── order_items: tied to parent order visibility ───────────────────────
    match /order_items/{id} {
      allow read: if resource.data.order_id != null
        && (isAdmin()
            || isManager()
            || get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.customer_id
               == request.auth.uid);
      allow write: if false; // managed server-side within order transactions
    }

    // ── audit_log: admins may read; written server-side ────────────────────
    match /audit_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
